# Copie para `.env` (mesma pasta deste arquivo) antes de `docker compose up`.
# `.env` está no .gitignore; este exemplo não carrega segredo real.
#
# Gere um segredo forte com:  openssl rand -hex 32

JWT_SECRET=troque-por-um-segredo-aleatorio-de-64-hex
JWT_EXPIRES_IN=2h

# NODE_ENV não fica aqui: o compose fixa `production` na imagem de execução
# (assim um NODE_ENV=development exportado no shell não muda o formato dos logs).

# Credenciais do banco criadas pelo MariaDB no primeiro boot.
# Troque antes de qualquer ambiente compartilhado.
# O prefixo ELAB_ evita que DB_USER/DB_PASSWORD exportados no shell vençam
# estas variáveis (isso já causou o app logar como outra conta e travar).
ELAB_DB_NAME=elab
ELAB_DB_USER=elab
ELAB_DB_PASSWORD=elab_dev
ELAB_DB_ROOT_PASSWORD=elab_root_dev

# Porta publicada na máquina para o app (front + API).
APP_PORT=3000

# No boot, o app aplica migrations e carrega o catálogo (ambos idempotentes).
# RUN_MIGRATIONS=false / RUN_SEED=false desligam cada etapa.
# RUN_MIGRATIONS=true
# RUN_SEED=true
#
# Atenção: mudar ELAB_DB_USER/ELAB_DB_PASSWORD depois do primeiro boot exige
# recriar o volume (`docker compose down -v`), porque o MariaDB só cria a conta
# no primeiro boot; o banco antigo continua com a credencial anterior.

# Limites de tentativa por IP (padrão do compose: 200 logins e 100 uploads).
# A suíte de testes faz ~35 logins/registros; cada rodada reinicia a janela se
# você reiniciar o app. Baixe para perto de 20/30 se a instância for pública.
# AUTH_RATE_LIMIT_MAX=200
# UPLOAD_RATE_LIMIT_MAX=100
